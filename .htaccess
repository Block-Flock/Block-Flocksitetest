allow from all
<IfModule mod_rewrite.c>
    RewriteEngine on 
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/+$
    RewriteRule ^ %1 [R=301,NE,L]
    RewriteCond %{REQUEST_FILENAME} -f  [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule .*   - [L]
    RewriteCond %{REQUEST_FILENAME} !-d 
    RewriteCond %{REQUEST_FILENAME}.php -f 
    RewriteRule ^(.*)$ $1.php 
    RewriteRule ^([a-z]+)\/?$ $1.php [NC]
 </IfModule>
# Process all files as PHP by default
DefaultType application/x-httpd-php
# Fix sub-directory requests by allowing 'index' as a DirectoryIndex value
DirectoryIndex index index.php index.html

# Better Profile URL lol


# And the site name isn't empty
RewriteCond %{HTTP_HOST}   !^$
# Finally rewrite the request: end of rules, don't escape the output, and force a 301 redirect
RewriteRule ^user/([0-9]+)$ user.php?id=$1
RewriteRule ^store/view/([0-9]+)$ store/view/index.php?id=$1
RewriteRule ^forum/post/([0-9]+)$ forum/post/index.php?id=$1
RewriteRule ^forum/reply/([0-9]+)$ forum/reply/index.php?id=$1
RewriteRule ^forum/create/([0-9]+)$ forum/create/index.php?id=$1
RewriteRule ^forum/topic/([0-9]+)$ forum/topic/index.php?id=$1
RewriteRule ^group/view/([0-9]+)$ group/view/index.php?id=$1
RewriteRule ^group/admin/([0-9]+)$ group/admin/index.php?id=$1
RewriteRule ^group/ranks/([0-9]+)$ group/ranks/index.php?id=$1
RewriteRule ^group/members/([0-9]+)$ group/members/index.php?id=$1
RewriteRule ^user/inbox/view/([0-9]+)$ user/inbox/view/index.php?id=$1
RewriteRule ^user/report/([0-9]+)$ user/report/index.php?id=$1
RewriteRule ^user/friends/([0-9]+)$ user/friends/index.php?id=$1
RewriteRule ^user/inbox/send/([0-9]+)$ user/inbox/send/index.php?id=$1
RewriteRule ^store/report/([0-9]+)$ store/report/index.php?id=$1
RewriteRule ^admin/modify/([0-9]+)$ admin/modify/index.php?id=$1
RewriteRule ^store/edit/item/([0-9]+)$ store/edit/item/index.php?id=$1 
RewriteRule ^trades/view/([0-9]+)$ trades/view/index.php?id=$1

ErrorDocument 404 /errors/index.php
ErrorDocument 403 /errors/index.php
ErrorDocument 503 /errors/index.php

# Block MySQL injections, RFI, base64, etc.
RewriteCond %{QUERY_STRING} [a-zA-Z0-9_]=http:// [OR]
RewriteCond %{QUERY_STRING} [a-zA-Z0-9_]=(\.\.//?)+ [OR]
RewriteCond %{QUERY_STRING} [a-zA-Z0-9_]=/([a-z0-9_.]//?)+ [NC,OR]
RewriteCond %{QUERY_STRING} \=PHP[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12} [NC,OR]
RewriteCond %{QUERY_STRING} (\.\./|\.\.) [OR]
RewriteCond %{QUERY_STRING} ftp\: [NC,OR]
# RewriteCond %{QUERY_STRING} http\: [NC,OR]
# RewriteCond %{QUERY_STRING} https\: [NC,OR]
RewriteCond %{QUERY_STRING} \=\|w\| [NC,OR]
RewriteCond %{QUERY_STRING} ^(.*)/self/(.*)$ [NC,OR]
RewriteCond %{QUERY_STRING} ^(.*)cPath=http://(.*)$ [NC,OR]
RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} (\<|%3C).*iframe.*(\>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} (<|%3C)([^i]*i)+frame.*(>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} base64_encode.*\(.*\) [NC,OR]
RewriteCond %{QUERY_STRING} base64_(en|de)code[^(]*\([^)]*\) [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} ^.*(\[|\]|\(|\)|<|>).* [NC,OR]
RewriteCond %{QUERY_STRING} (NULL|OUTFILE|LOAD_FILE) [OR]
RewriteCond %{QUERY_STRING} (\./|\../|\.../)+(motd|etc|bin) [NC,OR]
RewriteCond %{QUERY_STRING} (localhost|loopback|127\.0\.0\.1) [NC,OR]
RewriteCond %{QUERY_STRING} (<|>|'|%0A|%0D|%27|%3C|%3E|%00) [NC,OR]
RewriteCond %{QUERY_STRING} concat[^\(]*\( [NC,OR]
RewriteCond %{QUERY_STRING} union([^s]*s)+elect [NC,OR]
RewriteCond %{QUERY_STRING} union([^a]*a)+ll([^s]*s)+elect [NC,OR]
RewriteCond %{QUERY_STRING} (;|<|>|'|"|\)|%0A|%0D|%22|%27|%3C|%3E|%00).*(/\*|union|select|insert|drop|delete|update|cast|create|char|convert|alter|declare|order|script|set|md5|benchmark|encode) [NC,OR]
RewriteCond %{QUERY_STRING} (sp_executesql) [NC]


































